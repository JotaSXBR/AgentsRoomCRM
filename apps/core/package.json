{
  "name": "@agentsroom/core",
  "version": "0.1.0",
  "private": true,
  "description": "AgentsRoomCRM core API — auth, workspaces, convites, isolamento por workspace_id + RLS.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --loader ts-node/esm src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@agentsroom/db": "0.1.0",
    "@agentsroom/shared": "0.1.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.13",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
