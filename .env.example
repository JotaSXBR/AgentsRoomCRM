# --- Core ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Segredo JWT (gerar um por ambiente: `openssl rand -base64 48`)
JWT_SECRET=trocar-em-cada-ambiente
JWT_EXPIRES_IN=12h

# --- Postgres ( Coolify: serviço "postgres" de cada ambiente ) ---
# O usuário do app deve ser o role restrito (app_user). Migrações usam o owner.
DATABASE_URL=postgres://app_user:trocar@postgres:5432/agentsroom
DATABASE_URL_MIGRATOR=postgres://postgres:trocar@postgres:5432/agentsroom
# Senha do role app_user (criado/atualizado pelo `npm run migrate`)
APP_DB_PASSWORD=trocar-senha-app-user
# Driver de persistência: postgres (prod/staging) | memory (dev/teste)
STORE_DRIVER=postgres

# --- Redis ( Coolify: serviço "redis" de cada ambiente ) ---
REDIS_URL=redis://redis:6379

# --- Seed do dono (primeiro boot / `npm run seed`) ---
OWNER_EMAIL=dono@exemplo.com
OWNER_PASSWORD=trocar-senha-forte
OWNER_NAME=Dono

# --- Convites ---
INVITE_TOKEN_BYTES=32
INVITE_TTL_HOURS=72

# --- Meta oficial (F2b: Messenger + Instagram, Graph API v21+) ---
# App criado em developers.facebook.com → produtos Messenger + Instagram.
META_APP_ID=
META_APP_SECRET=
# Token de verificação da assinatura do webhook (você inventa, cola no painel Meta).
META_VERIFY_TOKEN=
# URL pública do core que recebe o OAuth + webhooks (staging/prod).
META_REDIRECT_URI=
META_API_VERSION=v21.0

# --- Fila de saída com backoff (F2b) ---
# Tentativas máximas por item; espera base (ms) dobrando a cada falha, até o teto.
OUTBOUND_MAX_ATTEMPTS=8
OUTBOUND_BASE_DELAY_MS=30000
OUTBOUND_MAX_DELAY_MS=3600000
# Ticker automático do processador (0 = desligado; staging: 15000).
OUTBOUND_TICK_MS=0
# Polling IMAP automático de todos os mailboxes (0 = desligado, usar POST /mail/sync).
MAIL_SYNC_INTERVAL_MS=0
# --- F5: entrega de webhooks de saída (retry com backoff exponencial) ---
# 0 = desligado: os eventos são enfileirados, mas ninguém entrega.
WEBHOOK_TICK_MS=15000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BASE_DELAY_MS=30000
WEBHOOK_MAX_DELAY_MS=3600000

# --- Serviços adjacentes (contrato reservado; consumo em F1) ---
# Gateway WhatsApp (sessão criada por coolify/waha/bootstrap.sh)
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=
WAHA_DEFAULT_SESSION=padrao
# Segredo compartilhado entre WAHA (webhook) e o core /webhooks/waha
WAHA_WEBHOOK_SECRET=
# S3-compatível / RustFS (buckets criados por coolify/rustfs/bootstrap.sh)
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_MIDIA=crm-midia
S3_BUCKET_BACKUPS=crm-backups
# LLM local opcional (serviço ollama, profile `ai`)
OLLAMA_URL=http://ollama:11434
