{
  "name": "agentsroom-crm",
  "version": "0.1.0",
  "private": true,
  "description": "AgentsRoomCRM — monorepo (apps/core + packages). F0: fundação + auth/workspaces + RLS.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@agentsroom/shared && npm run build --workspace=@agentsroom/db && npm run build --workspace=@agentsroom/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:core": "npm run dev --workspace=@agentsroom/core",
    "migrate": "npm run migrate --workspace=@agentsroom/core",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "eslint --config eslint.typed.config.mjs ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=20"
  }
}
