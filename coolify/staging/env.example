# Projeto AgentsRoomCRM-staging — variáveis (tudo DIFERENTE da prod).
# Mesma regra: bancos geram as credenciais; copiar Internal URLs.

# ===== core (Application) =====
JWT_SECRET=gerar-outro-com-openssl-rand-base64-48
JWT_EXPIRES_IN=12h
OWNER_EMAIL=dono@staging.exemplo.com
OWNER_PASSWORD=gerar-senha-forte-do-dono-staging
DATABASE_URL_MIGRATOR=postgres://postgres:<gerada-no-painel>@<container-postgres>:5432/agentsroom
# DATABASE_URL=postgres://app_user:<APP_DB_PASSWORD>@<container-postgres>:5432/agentsroom
APP_DB_PASSWORD=gerar-outra-senha-forte-app-user
REDIS_URL=redis://:<gerada-no-painel>@<container-redis>:6379

# ===== waha (Service) =====
WAHA_API_KEY=gerar-outra-chave-longa
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=gerar-outra-senha-forte
WAHA_DEFAULT_SESSION=padrao
WAHA_LOG_LEVEL=debug
# Webhook do WAHA → intake do core (mesmo Redis/rede interna do projeto).
# WAHA_HOOK_URL=http://core:3000/webhooks/waha?secret=<WAHA_WEBHOOK_SECRET>
# WAHA_HOOK_EVENTS=message,session.status
# WAHA_HOOK_RETRIES_POLICY=linear

# ===== storage (Service) =====
RUSTFS_ACCESS_KEY=gerar-outro-access-key
RUSTFS_SECRET_KEY=gerar-outro-secret-forte

# ===== ollama (one-click, opcional) =====
OLLAMA_MODELS=
