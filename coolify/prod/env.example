# Projeto AgentsRoomCRM-prod — variáveis (origens, não valores reais).
# Credenciais de banco/redis: GERADAS pelo Coolify em cada Database;
# colar as Internal URLs nos consumidores conforme indicado abaixo.

# ===== core (Application) =====
JWT_SECRET=gerar-com-openssl-rand-base64-48
JWT_EXPIRES_IN=12h
OWNER_EMAIL=dono@exemplo.com
OWNER_PASSWORD=gerar-senha-forte-do-dono
# Copiar Internal URL do Database `postgres` (usuário owner):
DATABASE_URL_MIGRATOR=postgres://postgres:<gerada-no-painel>@<container-postgres>:5432/agentsroom
# Mesma URL, trocando para o role restrito criado pelo migrate:
# DATABASE_URL=postgres://app_user:<APP_DB_PASSWORD>@<container-postgres>:5432/agentsroom
APP_DB_PASSWORD=gerar-senha-forte-app-user
# Copiar Internal URL do Database `redis` (com senha):
REDIS_URL=redis://:<gerada-no-painel>@<container-redis>:6379

# ===== waha (Service) — chaves GERADAS na criação, espelhar aqui =====
WAHA_API_KEY=gerar-chave-longa
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=gerar-senha-forte
WAHA_DEFAULT_SESSION=padrao
WAHA_LOG_LEVEL=info
# Webhook do WAHA → intake do core (mesmo Redis/rede interna do projeto).
# WAHA_HOOK_URL=http://core:3000/webhooks/waha?secret=<WAHA_WEBHOOK_SECRET>
# WAHA_HOOK_EVENTS=message,session.status
# WAHA_HOOK_RETRIES_POLICY=linear

# ===== meta oficial F2b (Application core) — segredos GERADOS no painel Meta =====
META_APP_ID=<id-do-app-meta>
META_APP_SECRET=gerar-no-painel-do-app-meta
META_VERIFY_TOKEN=gerar-token-de-verificacao-do-webhook
META_REDIRECT_URI=https://<dominio-do-core>/meta/callback
# META_API_VERSION=v21.0

# ===== fila de saída + polling IMAP (F2b; 0 = desligado, usa o padrão do código) =====
# OUTBOUND_MAX_ATTEMPTS=8
# OUTBOUND_BASE_DELAY_MS=30000
# OUTBOUND_MAX_DELAY_MS=3600000
# OUTBOUND_TICK_MS=15000
# MAIL_SYNC_INTERVAL_MS=300000

# ===== F5: entrega de webhooks de saida (retry com backoff) =====
# WEBHOOK_TICK_MS=15000
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_BASE_DELAY_MS=30000
# WEBHOOK_MAX_DELAY_MS=3600000

# ===== F5: backup do Postgres e dos volumes -> RustFS (scripts do recurso postgres) =====
# Rodar backup.sh/restore.sh no host; estas vars sao lidas por eles.
# BACKUP_BUCKET=crm-backups
# BACKUP_RETENTION_DAYS=30
# RUSTFS_URL=http://rustfs:9000

# ===== storage (Service) — chaves GERADAS na criação =====
RUSTFS_ACCESS_KEY=gerar-access-key
RUSTFS_SECRET_KEY=gerar-secret-forte

# ===== ollama (one-click, opcional) =====
OLLAMA_MODELS=
